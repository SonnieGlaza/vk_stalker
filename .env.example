# VK Long Poll: токен сообщества (права: сообщения, документы, фото, управление беседами).
VK_TOKEN=your_vk_community_token
# ID сообщества (например 1234567890; берётся из адреса https://vk.com/club<id>).
VK_GROUP_ID=1234567890
# Railway Postgres (приоритетнее DB_PATH, если задан).
DATABASE_URL=postgresql://user:password@host:5432/railway
# Локальный SQLite-файл (используется, если DATABASE_URL пустой.
.
DB_PATH=/data/stalker_game.db
# Резервная копия состояния (JSON), синхронизируется каждые 5 минут.
.
SNAPSHOT_PATH=/data/stalker_game.backup.json
# Список VK user ID админов через запятую (для команд give/title/setseason и т.п.).
ADMIN_IDS=123456,789012
# Ссылка на товар сообщества (VK Market) для пополнения; админ выдаёт по этой ссылке.
VK_MARKET_URL=https://vk.com/market-123456?section=item_1
# Callback API (вместо Long Poll): 1 — включить webhook; нужен публичный HTTPS-URL.
VK_USE_CALLBACK=0
VK_WEBHOOK_PORT=8080
# Код подтверждения и секрет из «Управление → Работа с API → Callback API» группы.
VK_CONFIRMATION_CODE=
VK_CALLBACK_SECRET=
# Опционально: ID бесед/пиров Зоны (в VK peer_id ЛС = user_id; беседа = 2000000000 + id чата）。.
# ZONE_COMMON_CHAT_ID=2000000001
# ZONE_CHAT_ДОЛГ=2000000002
# ZONE_CHAT_СВОБОДА=2000000003
# ZONE_CHAT_НЕЙТРАЛЫ=2000000004
# ZONE_CHAT_БАНДИТЫ=2000000005